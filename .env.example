# SafeGuard SOS — environment configuration
# All values are OPTIONAL. The app runs fully without any of them.

# ---- Database ----
# SQLite file URL for Prisma. Prefer an ABSOLUTE path to keep the live DB location
# stable regardless of working directory, e.g. on this OneDrive-hosted checkout:
#   DATABASE_URL="file:C:/safeguard-sos-local/dev.db"
DATABASE_URL="file:./dev.db"

# ---- Maps & Routing (optional) ----
# When set, enables Google Maps JS view and real Google Directions routing.
# When absent, the app automatically uses Leaflet + OpenStreetMap and simulated routing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---- Auth ----
# Secret used to sign session JWTs. A default dev secret is used if unset.
SESSION_SECRET=

# ---- Server URL (used for absolute links in notifications) ----
APP_URL=http://localhost:3000

# ---- Tunables (defaults shown) ----
# COUNTDOWN_SECONDS=10
# DANGER_RADIUS_M=50
# BUFFER_END_M=100
# MAX_ALERT_RADIUS_M=2000
# LOCATION_INTERVAL_MS=5000
# CLUSTER_RADIUS_M=50
